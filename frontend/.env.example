# Environment variables untuk frontend Next.js (DinusNexus)
# Salin ke frontend/.env.local dan sesuaikan bila perlu.
# Hanya variabel berprefiks NEXT_PUBLIC_ yang terekspos ke browser.
# Jangan menaruh secret/API key di sini.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Opsional untuk akses API key demo; login email/password PostgreSQL tidak memerlukannya.
# Local development only. This backend credential is exposed to the browser.
# Use a dedicated non-production key and never commit the actual value.
NEXT_PUBLIC_DINUSNEXUS_API_KEY=change-this-to-a-local-development-key
