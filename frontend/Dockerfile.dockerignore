# Allowlist untuk build dari root; mengalahkan .dockerignore backend.
**
!frontend/
!frontend/**
!src/
!src/data/
!src/data/*.json
frontend/node_modules/
frontend/.next/
frontend/.env*
frontend/e2e/
frontend/test-results/
frontend/playwright-report/
frontend/*.tsbuildinfo
**/.git/
**/__pycache__/
**/*.log
**/.env*
**/*.pem
**/*.key
